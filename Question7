import java.util.Scanner;

public class Question7 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Enter the number of squares: ");
        int n = input.nextInt();
        long sum = 0;

        for (long i = 1; i <= n; i++)
            sum += i * i;

        System.out.println("Sum of squares: " + sum);
    }
}
